{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-maze",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // The React SPA is built by Vite and served from the same Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Custom Domain: Cloudflare creates the DNS record and certificate on deploy (zone: tenkoh.dev).
  "routes": [{ "pattern": "voice-maze.jevpoc.tenkoh.dev", "custom_domain": true }],
  "workers_dev": false,
  // Secrets: TYPESAFE_API_KEY (local: .dev.vars / remote: `wrangler secret put TYPESAFE_API_KEY`)
}
